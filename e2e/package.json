{
  "name": "service-pulse-e2e",
  "version": "1.0.0",
  "description": "Playwright TypeScript E2E UI Automation Suite for Service Pulse",
  "scripts": {
    "setup": "npm install && npx playwright install --with-deps",
    "install:browsers": "playwright install --with-deps",
    "install:chromium": "playwright install chromium",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "testing",
    "service-pulse"
  ],
  "author": "ServicePulse Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  }
}
