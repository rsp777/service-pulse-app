# Docker Compose Secrets Setup
# ─────────────────────────────
# Create a 'secrets/' directory next to docker-compose.yml and add one file per secret.
# Each file should contain ONLY the raw value (no quotes, no newline at end).
#
# Example:
#   mkdir -p secrets
#   echo -n "ravi"                    > secrets/db_username.txt
#   echo -n "your_secure_password"    > secrets/db_password.txt
#   echo -n "ravi"                    > secrets/ssh_username.txt
#   echo -n "your_passphrase"         > secrets/ssh_private_key_passphrase.txt
#
# ──────────────── Host SSH Directory ────────────────
# Absolute path on your HOST server containing id_ed25519 and known_hosts
HOST_SSH_DIR=/home/ravi/.ssh
