<!DOCTYPE logback>
<configuration>
    <property name="LOG_PATTERN" value="%date{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} [%thread] %-5level %logger{40} - %msg%n" />

    <!-- Suppress Logback internal logging -->
    <logger name="ch.qos.logback" level="WARN" />

    <!-- ── Console appender (INFO+) ──────────────────────────────────── -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- ── Rolling file appender (all levels) ────────────────────────── -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/application.log.%d{yyyy-MM-dd}.log.tar.gz</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ── Error-only rolling file appender ──────────────────────────── -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/error.log.%d{yyyy-MM-dd}.log.tar.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>

    <!-- ── In-memory ring-buffer appender (System Logs UI) ───────────── -->
    <appender name="MEMORY" class="com.pawar.todo.amt.logging.SystemLogAppender" />

    <!-- ── Suppress SQL / Hibernate query logging ─────────────────────── -->
    <logger name="org.hibernate.SQL"              level="WARN" />
    <logger name="org.hibernate.orm.jdbc.bind"    level="WARN" />
    <logger name="org.hibernate.type"             level="WARN" />
    <logger name="org.hibernate.engine.jdbc"      level="WARN" />
    <logger name="com.zaxxer.hikari"              level="WARN" />

    <!-- ── Suppress Spring framework verbosity ───────────────────────── -->
    <logger name="org.springframework"            level="WARN" />

    <!-- ── Application loggers ───────────────────────────────────────── -->
    <logger name="com.pawar.todo.amt"             level="INFO" />
    <logger name="com.pawar.sop"                  level="INFO" />

    <logger name="AUDIT_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="FILE" />
    </logger>

    <root level="INFO" additivity="false">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
        <appender-ref ref="MEMORY" />
    </root>
</configuration>
