<?xml version="1.1" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1-init" author="service-pulse" dbms="mysql">
        <sqlFile path="sql/V1__init.sql" relativeToChangelogFile="true" splitStatements="true" stripComments="false"/>
    </changeSet>

    <!-- Issue #26: Add SSH configuration columns to server table [Author: Ravindra Singh Pawar / Antigravity] -->
    <changeSet id="2-add-server-ssh-fields" author="Ravindra Singh Pawar / Antigravity" dbms="mysql">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="server" columnName="ssh_port"/>
            </not>
        </preConditions>
        <addColumn tableName="server">
            <column name="ssh_port" type="INT" defaultValueNumeric="22">
                <constraints nullable="true"/>
            </column>
            <column name="ssh_username" type="VARCHAR(100)" defaultValue="ubuntu">
                <constraints nullable="true"/>
            </column>
            <column name="ssh_key_id" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
