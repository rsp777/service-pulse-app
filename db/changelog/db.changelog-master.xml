<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">

    <changeSet id="1" author="full-stack-developer">
        <createTable tableName="services">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="VARCHAR(255)"/>
            <column name="type" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="unknown"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="full-stack-developer">
        <createTable tableName="metrics">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="service_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="value" type="DOUBLE"/>
            <column name="metric_type" type="VARCHAR(50)"/>
            <column name="timestamp" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="metrics" baseColumnNames="service_id" constraintName="fk_service_id" referencedTableName="services" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="3" author="full-stack-developer">
        <insert tableName="services">
            <column name="name" value="Google"/>
            <column name="url" value="https://google.com"/>
            <column name="type" value="http"/>
        </insert>
        <insert tableName="services">
            <column name="name" value="GitHub"/>
            <column name="url" value="https://github.com"/>
            <column name="type" value="http"/>
        </insert>
        <insert tableName="services">
            <column name="name" value="Local DB"/>
            <column name="url" value="localhost:5432"/>
            <column name="type" value="tcp"/>
        </insert>
    </changeSet>

    <changeSet id="4" author="full-stack-developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="servers"/>
            </not>
        </preConditions>
        <createTable tableName="servers">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="hostname" type="VARCHAR(255)"/>
            <column name="ip" type="VARCHAR(50)"/>
            <column name="os_type" type="VARCHAR(50)"/>
            <column name="ssh_user" type="VARCHAR(100)"/>
            <column name="ssh_key_path" type="VARCHAR(500)"/>
            <column name="status" type="VARCHAR(20)"/>
        </createTable>
    </changeSet>

    <changeSet id="5" author="full-stack-developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="services" columnName="server_id"/>
            </not>
        </preConditions>
        <addColumn tableName="services">
            <column name="server_id" type="INT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="services" baseColumnNames="server_id" constraintName="fk_server_id" referencedTableName="servers" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="6" author="full-stack-developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="system_config"/>
            </not>
        </preConditions>
        <createTable tableName="system_config">
            <column name="config_key" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="config_value" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>

    <changeSet id="7" author="full-stack-developer">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="services" columnName="start_script"/>
            </not>
        </preConditions>
        <addColumn tableName="services">
            <column name="start_script" type="VARCHAR(500)"/>
            <column name="stop_script" type="VARCHAR(500)"/>
            <column name="restart_script" type="VARCHAR(500)"/>
            <column name="logs_path" type="VARCHAR(500)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>